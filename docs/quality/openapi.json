  "components": {
    "securitySchemes": {
      "token": {
        "type": "apiKey",
        "in": "header",
        "name": "token"
      }
    },
    "schemas": {
      "Draft": {
        "type": "object",
        "properties": {
          "requestKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64
          },
          "supplierId": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "requestKey",
          "supplierId",
          "title"
        ]
      },
      "Scar": {
        "type": "object",
        "properties": {
          "requestKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64
          },
          "supplierId": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "maxLength": 128
          },
          "defectKey": {
            "type": "string",
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "severity": {
            "type": "string",
            "pattern": "MINOR|MAJOR|SEVERE"
          }
        },
        "required": [
          "requestKey",
          "supplierId",
          "title",
          "defectKey",
          "description",
          "severity"
        ]
      },
      "Item": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128
          },
          "fileId": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "fileId"
        ]
      },
      "Ppap": {
        "type": "object",
        "properties": {
          "rowVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0.0
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50
          },
          "comment": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "rowVersion",
          "items",
          "comment"
        ]
      },
      "EightD": {
        "type": "object",
        "properties": {
          "rowVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0.0
          },
          "disciplines": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "minProperties": 8,
            "maxProperties": 8
          },
          "fileIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 20
          }
        },
        "required": [
          "rowVersion",
          "disciplines",
          "fileIds"
        ]
      },
      "Review": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "pattern": "APPROVE|REJECT|RETURN"
          },
          "comment": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "action",
          "comment"
        ]
      },
      "Close": {
        "type": "object",
        "properties": {
          "rowVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0.0
          },
          "effectiveness": {
            "type": "string",
            "maxLength": 2000
          },
          "evidenceRef": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "rowVersion",
          "effectiveness",
          "evidenceRef"
        ]
      },
      "Risk": {
        "type": "object",
        "properties": {
          "requestKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64
          },
          "supplierId": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "evidenceRef": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "requestKey",
          "supplierId",
          "description",
          "evidenceRef"
        ]
      },
      "Assess": {
        "type": "object",
        "properties": {
          "rowVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0.0
          },
          "level": {
            "type": "string",
            "pattern": "HIGH|MEDIUM|LOW"
          },
          "comment": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "rowVersion",
          "level",
          "comment"
        ]
      },
      "Dispose": {
        "type": "object",
        "properties": {
          "rowVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0.0
          },
          "action": {
            "type": "string",
            "pattern": "RECTIFIED|MONITOR|APPROVAL_SUBMITTED"
          },
          "comment": {
            "type": "string",
            "maxLength": 2000
          },
          "evidenceRef": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "rowVersion",
          "action",
          "comment",
          "evidenceRef"
        ]
      },
      "Policy": {
        "type": "object",
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0.0
          },
          "responseDays": {
            "type": "integer",
            "format": "int32",
            "minimum": 1.0,
            "maximum": 365.0
          },
          "repeatWindowDays": {
            "type": "integer",
            "format": "int32",
            "minimum": 1.0,
            "maximum": 365.0
          },
          "minorDeduction": {
            "type": "number",
            "description": "Exact decimal; do not use binary floating point to construct monetary or score values.",
            "minimum": 0.0,
            "maximum": 100.0
          },
          "majorDeduction": {
            "type": "number",
            "description": "Exact decimal; do not use binary floating point to construct monetary or score values.",
            "minimum": 0.0,
            "maximum": 100.0
          },
          "severeDeduction": {
            "type": "number",
            "description": "Exact decimal; do not use binary floating point to construct monetary or score values.",
            "minimum": 0.0,
            "maximum": 100.0
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "expectedVersion",
          "responseDays",
          "repeatWindowDays",
          "minorDeduction",
          "majorDeduction",
          "severeDeduction",
          "reason"
        ]
      },
      "Mapping": {
        "type": "object",
        "properties": {
          "connectorId": {
            "type": "string"
          },
          "externalKey": {
            "type": "string",
            "maxLength": 80
          },
          "supplierId": {
            "type": "string"
          }
        },
        "required": [
          "connectorId",
          "externalKey",
          "supplierId"
        ]
      },
      "Inspection": {
        "type": "object",
        "properties": {
          "supplierKey": {
            "type": "string",
            "maxLength": 80
          },
          "period": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "pattern": "PASS|FAIL"
          },
          "severity": {
            "type": "string",
            "pattern": "MINOR|MAJOR|SEVERE"
          },
          "sourceRef": {
            "type": "string",
            "maxLength": 500
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "supplierKey",
          "period",
          "result",
          "severity",
          "sourceRef",
          "description"
        ]
      },
      "ErpScores": {
        "type": "object",
        "properties": {
          "supplierKey": {
            "type": "string",
            "maxLength": 80
          },
          "period": {
            "type": "string"
          },
          "scores": {
            "type": "array",
            "items": {
              "type": "number",
              "description": "Exact decimal; do not use binary floating point to construct monetary or score values."
            },
            "minItems": 4,
            "maxItems": 4
          },
          "sourceRef": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "supplierKey",
          "period",
          "scores",
