  "components": {
    "securitySchemes": {
      "token": {
        "type": "apiKey",
        "in": "header",
        "name": "token"
      }
    },
    "schemas": {
      "CommonResult": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "msg": {
            "type": "string"
          },
          "data": {}
        }
      },
      "Line": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "material": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "minimum": 0.001,
            "maximum": 1000000,
            "multipleOf": 0.001
          },
          "delivery": {
            "type": "string"
          },
          "specification": {
            "type": "string"
          },
          "benchmark": {
            "type": "number",
            "nullable": true,
            "multipleOf": 0.0001
          },
          "fileIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0,
            "maxItems": 10
          }
        },
        "required": [
          "id",
          "material",
          "quantity",
          "delivery",
          "fileIds"
        ]
      },
      "Rfq": {
        "type": "object",
        "properties": {
          "requestKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64
          },
          "rowVersion": {
            "type": "integer",
            "format": "int64"
          },
          "rfqNo": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "strategy": {
            "type": "string",
            "enum": [
              "COMPARE",
              "AUCTION"
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "CNY",
              "USD",
              "EUR"
            ]
          },
          "deadline": {
            "type": "integer",
            "format": "int64",
            "description": "Unix epoch milliseconds, future and <=366 days"
          },
          "startAt": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "supplierIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 50
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Line"
            },
            "minItems": 1,
            "maxItems": 100
          },
          "startingPrice": {
            "type": "number"
          },
          "minDecrement": {
            "type": "number"
          },
          "antiSnipeMinutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60,
            "default": 5
          }
        },
        "required": [
          "requestKey",
          "title",
          "category",
          "strategy",
          "currency",
          "deadline",
          "supplierIds",
          "lines"
        ]
      },
      "Version": {
        "type": "object",
        "properties": {
          "rowVersion": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "rowVersion"
        ]
      },
      "Extend": {
        "type": "object",
        "properties": {
          "rowVersion": {
            "type": "integer",
            "format": "int64"
          },
          "deadline": {
            "type": "integer",
            "format": "int64"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "rowVersion",
          "deadline",
          "reason"
        ]
      },
      "QuoteLine": {
        "type": "object",
        "properties": {
          "lineId": {
            "type": "string"
          },
          "unitPrice": {
            "type": "number",
            "minimum": 0.0001,
            "multipleOf": 0.0001
          },
          "leadDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3650
          }
        },
        "required": [
          "lineId",
          "unitPrice",
          "leadDays"
        ]
      },
      "Quote": {
        "type": "object",
        "properties": {
          "requestKey": {
            "type": "string"
          },
          "expectedRound": {
            "type": "integer",
            "format": "int64"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuoteLine"
            },
            "minItems": 1,
            "maxItems": 100
          },
          "freight": {
            "type": "number",
            "minimum": 0,
            "multipleOf": 0.01
          },
          "remark": {
            "type": "string"
          }
        },
        "required": [
          "requestKey",
          "expectedRound",
          "lines",
          "freight"
        ]
      },
      "Bid": {
        "type": "object",
        "properties": {
          "rfqId": {
            "type": "string"
          },
          "requestKey": {
            "type": "string"
          },
          "expectedVersion": {
            "type": "integer",
            "format": "int64"
          },
          "amount": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 90000000000,
            "multipleOf": 0.01
          }
        },
        "required": [
          "rfqId",
          "requestKey",
          "expectedVersion",
          "amount"
        ]
      },
      "Question": {
        "type": "object",
        "properties": {
          "isPublic": {
            "type": "boolean"
          },
          "supplierId": {
            "type": "string",
            "nullable": true,
            "description": "Internal private question recipient only; portal identity is server-derived"
          },
          "question": {
            "type": "string"
          }
        },
        "required": [
          "isPublic",
          "question"
        ]
      },
      "Answer": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string"
          }
        },
        "required": [
          "answer"
        ]
      },
      "Risk": {
        "type": "object",
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "evidenceRef": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "level",
          "evidenceRef",
          "note"
        ]
      },
      "Award": {
        "type": "object",
        "properties": {
          "supplierId": {
            "type": "string"
          },
          "requestKey": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "noHistoryReason": {
            "type": "string"
          },
          "discloseLoss": {
            "type": "boolean"
          }
        },
        "required": [
          "supplierId",
          "requestKey",
          "reason"
        ]
      },
      "Decision": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REJECT",
              "TRANSFER",
              "REASSIGN"
            ]
          },
          "comment": {
            "type": "string"
          },
          "targetId": {
            "type": "string",
            "nullable": true
          },
          "approveNoHistory": {
            "type": "boolean"
          },
          "acknowledgeRisk": {
            "type": "boolean"
          },
          "noHistoryReason": {
            "type": "string"
          }
        },
        "required": [
          "action",
          "comment"
        ]
      },
      "Ticket": {
        "type": "object",
        "properties": {
          "rfqId": {
            "type": "string"
          }
        },
        "required": [
          "rfqId"
        ]
      }
    }
  }
}
